<?xml version="1.0" encoding="utf-8"?>
<!-- 离线可还原：Godot 的 .NET 包随编辑器一起发布在 GodotSharp/Tools/nupkgs，
     这里把它作为唯一包源，避免依赖 nuget.org。
     换 Godot 安装路径时记得同步这一行。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="E:\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
